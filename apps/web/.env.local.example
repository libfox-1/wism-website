# Microsoft Graph API
# Azure Portal → App registrations → your app
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# The shared mailbox that sends and receives the contact form emails
CONTACT_EMAIL=hello@wism.io

# Cloudflare Turnstile
# cloudflare.com → Turnstile → your site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key   # safe to expose — used in the browser
TURNSTILE_SECRET_KEY=your-secret-key            # keep private — only used server-side
